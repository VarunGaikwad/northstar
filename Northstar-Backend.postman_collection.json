  "info": {
    "_postman_id": "northstar-backend-collection",
    "name": "Northstar Backend",
    "description": "Postman collection for the Northstar backend API. Keep Postman's cookie jar enabled: login/register store the HttpOnly refresh cookie automatically, refresh rotates it, and the collection variable stores only the short-lived access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
