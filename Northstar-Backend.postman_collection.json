    {
      "name": "Auth",
      "description": "Keep Postman's cookie jar enabled for this host. Refresh credentials remain HttpOnly cookies and are never copied into collection variables. Login, registration, and refresh automatically update only {{authToken}} from the JSON response.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data?.accessToken) pm.collectionVariables.set('authToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data?.accessToken) pm.collectionVariables.set('authToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Session",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Uses and rotates the HttpOnly refresh cookie in Postman's cookie jar. No refresh credential belongs in a variable or request body.",
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data?.accessToken) pm.collectionVariables.set('authToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout Current Session",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Revokes the session represented by the refresh cookie and clears that cookie.",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('authToken');"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout All Sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "description": "Revokes every refresh session for the bearer-token user and clears the current cookie.",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout-all"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('authToken');"
                ]
              }
            }
          ],
          "response": []
        },
