NODE_ENV="development"
PORT=3000

# NeonDB connection string.
# Use the pooled connection (port 6543) for serverless/edge, or the direct
# connection (port 5432) for migrations (prisma migrate).
#
# Format:
# postgresql://<USER>:<PASSWORD>@<PROJECT>-pooler.region.aws.neon.tech/<DB>?sslmode=require
#
# Direct (for `prisma migrate` / `prisma db push`):
# postgresql://<USER>:<PASSWORD>@<PROJECT>.region.aws.neon.tech/<DB>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Optional: SMTP config for sending real emails.
# If omitted, password-reset emails are logged to the console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="working.varun.24@gmail.com"
SMTP_PASS=""
EMAIL_FROM="working.varun.24@gmail.com"

# Frontend URL(s). May be a single URL or a comma-separated list for multiple
# CORS origins. The FIRST entry is used for password-reset email links.
# Example: FRONTEND_URL="http://localhost:5173,http://localhost:3001,https://app.example.com"
FRONTEND_URL="http://localhost:5173"

# OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=""

# Unsplash API access key (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=""
