{
  "version": 2,
  "name": "northstar-backend",
  "buildCommand": "npm run prisma:generate && npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "dist\\index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist\\index.js"
    }
  ]
}
