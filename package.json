{
  "name": "northstar",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev:backend": "npm run dev --workspace=northstar-backend",
    "dev:frontend": "npm run dev --workspace=northstar-frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace=northstar-backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=northstar-backend",
    "prisma:deploy": "npm run prisma:deploy --workspace=northstar-backend",
    "prisma:studio": "npm run prisma:studio --workspace=northstar-backend"
  }
}
